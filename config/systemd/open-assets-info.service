[Unit]
Description=Open Assets filtered host status collector
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/app/open-assets
ExecStart=/app/open-assets/bin/open-assets telemetry --root /app/open-assets
UMask=0077
Environment=DOCKER_CONFIG=/tmp/open-assets-docker
TimeoutStartSec=25
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/asset-stack/info
