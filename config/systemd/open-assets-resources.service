[Unit]
Description=Open Assets cached Git and queue resource measurements
ConditionPathExists=!/app/open-assets/private/maintenance.flag

[Service]
Type=oneshot
WorkingDirectory=/app/open-assets
ExecStart=/usr/bin/python3 -m open_assets.resource_info --root /app/open-assets
UMask=0077
TimeoutStartSec=90
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/asset-stack/info
