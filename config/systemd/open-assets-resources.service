[Unit]
Description=Open Assets cached Git and queue resource measurements
ConditionPathExists=!/app/open-assets/private/maintenance.flag

[Service]
Type=oneshot
WorkingDirectory=/app/open-assets
ExecStart=/app/open-assets/bin/open-assets resource-info --root /app/open-assets
UMask=0077
TimeoutStartSec=90
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/asset-stack/info
