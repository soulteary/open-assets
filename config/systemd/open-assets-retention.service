[Unit]
Description=Open Assets opt-in local history retention
After=docker.service
Requires=docker.service
ConditionPathExists=!/app/open-assets/private/maintenance.flag

[Service]
Type=oneshot
WorkingDirectory=/app/open-assets
ExecStart=/usr/bin/docker compose exec -T publisher open-assets retention --apply
Environment=DOCKER_CONFIG=/tmp/open-assets-docker
UMask=0077
Nice=15
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
